# Copy this file to .env and replace the placeholder with your real key.
# Never commit the real .env file.
VITE_OPENWEATHER_API_KEY=your_api_key_here

# Set to "true" to intercept weather API calls with MSW (no real key required).
# Leave unset or "false" to call the real OpenWeatherMap REST API.
VITE_USE_MOCK_API=false