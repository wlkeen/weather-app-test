# ---------------------------------------------------------------------------
# Legacy (direct OWM from the browser). Only needed if you uncomment the old
# path in src/services/weatherApi.ts. Live forecast uses the .NET backend.
# ---------------------------------------------------------------------------
# VITE_OPENWEATHER_API_KEY=your_api_key_here

# Optional absolute base URL for the Weather API (no trailing slash).
# Leave unset in local dev — Vite proxies `/api` → http://localhost:5080.
# VITE_API_BASE_URL=http://localhost:5080

# Set to "true" to intercept `/api/weather/forecast` with MSW (no BE required).
# Leave unset or "false" to call the local .NET WeatherApi.
VITE_USE_MOCK_API=false

# Optional override for the online cities JSON URL.
# When unset, a public remote city list is used; on failure the app falls back to /data/cities.json.
# VITE_CITIES_REMOTE_URL=https://example.com/cities.json
